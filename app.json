{
  "expo": {
    "name": "Paluwagan",
    "slug": "paluwagan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paluwagan",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.anzzy1.paluwagan",
      "adaptiveIcon": {
        "backgroundColor": "#1DB954",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#0F0F10"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Paluwagan uses the camera to scan invite QR codes and photograph payment receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a screenshot of a payment receipt or an invite QR code.",
          "cameraPermission": "Take a photo of your payment receipt."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFC83D"
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6d8a7ae2-d4a1-439a-b4db-518cc4e194e1"
      }
    },
    "owner": "anzyydev"
  }
}
