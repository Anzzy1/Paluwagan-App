{
  "expo": {
    "name": "Paluwagan",
    "slug": "paluwagan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paluwagan",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1DB954",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#0F0F10"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Paluwagan uses the camera to scan invite QR codes and photograph payment receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a screenshot of a payment receipt or an invite QR code.",
          "cameraPermission": "Take a photo of your payment receipt."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFC83D"
        }
      ],
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
